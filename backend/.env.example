# House Helper — environment configuration
# Copy to .env and fill in real values for local development.

# --- Storage paths (defaults to repo-relative input_data/ and outputs/) ---
# INPUT_DATA_PATH=./input_data
# OUTPUT_PATH=./outputs

# --- Azure OpenAI (required for LLM services) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# --- FLUX.2-pro (required for imagineering service) ---
FLUX_API_KEY=your-flux-api-key
FLUX_API_URL=https://api.bfl.ml

# --- Distance calculator ---
DISTANCE_API_KEY=your-distance-api-key

# --- FastAPI server ---
# API_HOST=0.0.0.0
# API_PORT=8000

# --- Observability ---
# LOG_LEVEL=INFO

# --- CORS ---
# CORS_ORIGINS=["http://localhost:5173"]
